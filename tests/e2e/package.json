{
  "name": "launchpad-cn-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "N10/N12 end-to-end / UI tests and the e2e SCENARIO storyline for the Launchpad-CN console (Playwright). Not part of `make verify`.",
  "scripts": {
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc -p .",
    "scenario": "playwright test -c scenario.config.ts",
    "scenario:list": "playwright test -c scenario.config.ts --list",
    "unit": "node --test cn/*.unit.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
