{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccountAndResourceDiscovery",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "ec2:Describe*",
        "iam:Get*",
        "iam:List*",
        "iam:SimulatePrincipalPolicy",
        "resource-groups:Get*",
        "resource-groups:List*",
        "tag:GetResources",
        "tag:GetTagKeys",
        "tag:GetTagValues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AgentCoreAndBedrock",
      "Effect": "Allow",
      "Action": [
        "bedrock:*",
        "bedrock-agentcore:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SubscribeBedrockMarketplaceModels",
      "Effect": "Allow",
      "Action": [
        "aws-marketplace:ViewSubscriptions",
        "aws-marketplace:Subscribe"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockMantleInference",
      "Effect": "Allow",
      "Action": [
        "bedrock-mantle:Get*",
        "bedrock-mantle:List*",
        "bedrock-mantle:CreateInference"
      ],
      "Resource": "arn:aws:bedrock-mantle:*:*:project/*"
    },
    {
      "Sid": "BedrockMantleCallWithBearerToken",
      "Effect": "Allow",
      "Action": [
        "bedrock-mantle:CallWithBearerToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchpadSupportingServices",
      "Effect": "Allow",
      "Action": [
        "apigateway:*",
        "application-autoscaling:Describe*",
        "application-signals:*",
        "autoscaling:Describe*",
        "cloudformation:*",
        "cloudtrail:CreateServiceLinkedChannel",
        "cloudwatch:*",
        "cognito-idp:*",
        "codebuild:*",
        "dynamodb:*",
        "events:*",
        "lambda:*",
        "logs:*",
        "oam:ListSinks",
        "rum:Get*",
        "rum:List*",
        "secretsmanager:*",
        "sqs:*",
        "synthetics:Describe*",
        "synthetics:Get*",
        "xray:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchpadAndCdkBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::launchpad-*",
        "arn:aws:s3:::bedrock-agentcore-gateway-*",
        "arn:aws:s3:::bedrock-agentcore-runtime-*",
        "arn:aws:s3:::cdk-*"
      ]
    },
    {
      "Sid": "S3Discovery",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccountPublicAccessBlock",
        "s3:ListAllMyBuckets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LaunchpadAndCdkEcr",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": [
        "arn:aws:ecr:*:*:repository/launchpad-*",
        "arn:aws:ecr:*:*:repository/cdk-*"
      ]
    },
    {
      "Sid": "EcrAuthentication",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ManageLaunchpadAndCdkRoles",
      "Effect": "Allow",
      "Action": [
        "iam:AddRoleToInstanceProfile",
        "iam:AttachRolePolicy",
        "iam:CreateInstanceProfile",
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:CreateRole",
        "iam:DeleteInstanceProfile",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePolicy",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:SetDefaultPolicyVersion",
        "iam:TagInstanceProfile",
        "iam:TagPolicy",
        "iam:TagRole",
        "iam:UntagInstanceProfile",
        "iam:UntagPolicy",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": [
        "arn:aws:iam::*:instance-profile/launchpad-*",
        "arn:aws:iam::*:instance-profile/cdk-*",
        "arn:aws:iam::*:instance-profile/hnb659fds-*",
        "arn:aws:iam::*:policy/launchpad-*",
        "arn:aws:iam::*:policy/cdk-*",
        "arn:aws:iam::*:policy/hnb659fds-*",
        "arn:aws:iam::*:role/launchpad-*",
        "arn:aws:iam::*:role/cdk-*",
        "arn:aws:iam::*:role/hnb659fds-*"
      ]
    },
    {
      "Sid": "PassLaunchpadAndCdkRolesToRequiredServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::*:role/launchpad-*",
        "arn:aws:iam::*:role/cdk-*",
        "arn:aws:iam::*:role/hnb659fds-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "bedrock.amazonaws.com",
            "bedrock-agentcore.amazonaws.com",
            "cloudformation.amazonaws.com",
            "codebuild.amazonaws.com",
            "lambda.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "CreateRequiredServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": [
            "agent-registry.amazonaws.com",
            "application-signals.cloudwatch.amazonaws.com",
            "bedrock-agentcore.amazonaws.com",
            "identity-network.bedrock-agentcore.amazonaws.com",
            "network.bedrock-agentcore.amazonaws.com",
            "runtime-identity.bedrock-agentcore.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AgentCoreEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:GenerateDataKey",
        "kms:ListAliases",
        "kms:ListKeys"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadUbuntuAmiParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:*::parameter/aws/service/canonical/ubuntu/server/24.04/stable/current/arm64/hvm/ebs-gp3/ami-id"
    },
    {
      "Sid": "ManageCdkBootstrapParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:AddTagsToResource",
        "ssm:DeleteParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:ListTagsForResource",
        "ssm:PutParameter",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/cdk-bootstrap/*"
    },
    {
      "Sid": "UseSessionManager",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation",
        "ssm:ResumeSession",
        "ssm:StartSession",
        "ssm:TerminateSession"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SsmManagedInstance",
      "Effect": "Allow",
      "Action": [
        "ec2messages:AcknowledgeMessage",
        "ec2messages:DeleteMessage",
        "ec2messages:FailMessage",
        "ec2messages:GetEndpoint",
        "ec2messages:GetMessages",
        "ec2messages:SendReply",
        "ssm:UpdateInstanceInformation",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    }
  ]
}
