def memory_index_body() -> dict[str, Any]:
    """Long-term records: one row per fact/preference/summary a store holds."""
    keyword_fields = ("store_id", "workspace_id", "actor_id", "namespace", "strategy",
                       "session_id", "source_event_ids")
    return {
