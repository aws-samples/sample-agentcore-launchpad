"""__LAUNCHPAD_WORKER_NAME__ — the Launchpad evaluation worker (AgentCore Runtime, async).

Generated by AgentCore Launchpad (app/templates/eval_worker). One job per Runtime session:
the entrypoint validates the job, resolves the judge's Global Bedrock key on the request
thread (the only one that sees the Runtime-injected workload token — N12-bug8), writes
``status.json``, registers an async task (so ``/ping`` answers ``HealthyBusy`` and the
session lives to ``maxLifetime``), starts the job on a thread and acks within a second. The job replays the dataset against the target
runtime, waits for spans, runs the Strands evaluators / detectors with a judge on the Global
Bedrock bearer (resolved through AgentCore Identity exactly like every Launchpad runtime)
and streams progress + results to S3 ``evaluations/<job_id>/a<n>/``. Not wrapped by
``opentelemetry-instrument``: the judge traffic must never pollute ``aws/spans``.
"""

import contextvars
import os
import threading
from typing import Any

import boto3
from bedrock_agentcore.runtime import BedrockAgentCoreApp
from bedrock_agentcore.runtime.context import BedrockAgentCoreContext
from botocore.config import Config
from strands.models import BedrockModel

from launchpad_eval import code_evaluators, jobs_batch, judge_client, model_calls
from launchpad_eval.jobs import JobSpec, KindUnsupportedError
from launchpad_eval.sink import JobSink, S3Store

WORKER_NAME = "__LAUNCHPAD_WORKER_NAME__"
WORKER_RELEASE = __LAUNCHPAD_WORKER_RELEASE__
# N-SCN-bug1: the data-plane read timeout is the HUB's `Settings.agentcore_read_timeout_s`,
# rendered at install/repair time, so a cold first turn of a heavy agent (memory + KB +
# gateway + A2A + Code Interpreter) gets the same budget here as on the console (the
# synchronous InvokeAgentRuntime limit is 15 min; botocore's default is 60 s).
INVOKE_READ_TIMEOUT_S = __LAUNCHPAD_INVOKE_READ_TIMEOUT_S__
INVOKE_CONNECT_TIMEOUT_S = 10
# N-SCN-bug2: the judge / actor / summariser output budget. GLM 5.3 and Kimi K3 reason inside
# `max_tokens`, so a judge call STARTS at the per-model default inlined here from the hub's one
# capability table (schemas.agent.MODEL_CAPABILITIES["default_judge_max_tokens"]), never under
# the hub's `Settings.eval_judge_max_tokens` floor, and a call that still hits the output limit
# is retried with the budget doubled up to JUDGE_MAX_TOKENS_CAP
# (`Settings.eval_judge_max_tokens_cap`), at most twice — model_calls.call_with_budget.
JUDGE_DEFAULT_MAX_TOKENS: dict[str, int] = __LAUNCHPAD_JUDGE_DEFAULT_MAX_TOKENS__
JUDGE_MAX_TOKENS_FLOOR = __LAUNCHPAD_JUDGE_MAX_TOKENS_FLOOR__
JUDGE_MAX_TOKENS_CAP = __LAUNCHPAD_JUDGE_MAX_TOKENS_CAP__
# N12-obs53 / N12-obs55: a transient upstream error (Bedrock `internalServerException` on
# ConverseStream, throttling, a read timeout — runtime_invoke.is_upstream_transient) on a
# scenario replay or a judge call is retried up to 3 attempts, waiting these many seconds
# before the 2nd / 3rd attempt (`Settings.eval_transient_retry_backoff_seconds`). N13-obs8:
# each wait is sliced into ≤ 1 s sleeps that poll the S3 cancel marker between them
# (runtime_invoke.sliced_wait), so a stop mid-wait is honoured within about a second.
# N13-obs14: the ONLINE evaluation job's judge calls (jobs_online, bound by the dispatcher
# through WorkerEnv.transient_backoff_s) take this same list — one schedule for every judge.
TRANSIENT_RETRY_BACKOFF_S: tuple[float, ...] = __LAUNCHPAD_TRANSIENT_RETRY_BACKOFF_S__

__LAUNCHPAD_MODEL_SOURCE__


def _descriptor_judge_defaults() -> dict[str, int]:
    """D21: the per-model judge budgets the registered descriptors carry (`judge_max_tokens`),
    layered OVER the inlined JUDGE_DEFAULT_MAX_TOKENS table — a job payload's row wins."""
    out = dict(JUDGE_DEFAULT_MAX_TOKENS)
    for model_id, descriptor in MODEL_DESCRIPTORS.items():
        budget = descriptor.get("judge_max_tokens")
        if budget:
            out[model_id] = int(budget)
    return out


def judge_budget(model_id: str | None = None) -> int:
    """The output budget a judge call on ``model_id`` starts from (N-SCN-bug2): the catalog
    default for the model (its job descriptor first, D21) over the hub's floor, never above
    the cap."""
    return model_calls.resolve_budget(
        model_id or MODEL_ID, floor=JUDGE_MAX_TOKENS_FLOOR,
        defaults=_descriptor_judge_defaults(), cap=JUDGE_MAX_TOKENS_CAP,
    )


def judge_model(model_id: str | None = None, *, max_tokens: int | None = None,
                temperature: float = 0.0) -> Any:
    """The judge / actor / summariser / reflection model: the catalog model on its provider
    with the workspace's key (spec C3/C4) — ``build_model()``'s twin for an explicit id.
    ``jobs_online`` / ``jobs_recommend`` / ``jobs_optimize`` pass ``max_tokens`` and
    ``temperature``; the batch paths take the defaults (temperature 0, the model-aware
    ``judge_budget`` — N-SCN-bug2 — not the runtime's own MODEL_MAX_TOKENS)."""
    factory = JUDGE_FACTORY
    if factory is not None:
        return factory(model_id, max_tokens=max_tokens, temperature=temperature)
    # N-R6: `_launchpad_chat_model` dispatches on the inlined provider table — a SiliconFlow
    # judge gets `OpenAIModel` with that provider's Identity key, a Bedrock judge the bearer.
    # The judge-client bounds (judge_client): a stalled call ends within about 1–2× the
    # judge deadline instead of botocore's / OpenAI's defaults (15–30 min).
    model_id = model_id or MODEL_ID
    bedrock = _model_provider(model_id)["kind"] != "openai_compatible"
    model = _launchpad_chat_model(
        model_id=model_id,
        max_tokens=max_tokens or judge_budget(model_id),
        temperature=temperature,
        **({"boto_client_config": judge_client.bedrock_client_config()} if bedrock else {}),
    )
    return model if bedrock else judge_client.limit_openai_client(model)


# Test seams: the hermetic suite executes this module in-process and plugs fakes in here.
CLIENT_FACTORY: Any = None  # (service) -> boto3-like client
JUDGE_FACTORY: Any = None  # (model_id) -> strands Model

CREDENTIAL_CODE = "evaluation.worker_credential"  # ack code when the key is unobtainable


def _prefetch_judge_credential() -> None:
    """Request-thread hook (N12-bug8): capture the injected token and cache the Global
    Bedrock key before the job leaves this thread. A judge seam supplies its own model
    and needs no key."""
    if JUDGE_FACTORY is not None:
        return
    _prefetch_bedrock_api_key()

_REGION = os.environ.get("AWS_REGION", "cn-northwest-1")
_CLIENTS: dict[str, Any] = {}
_THREADS: dict[str, threading.Thread] = {}

app = BedrockAgentCoreApp()


# Per-service botocore config. `max_attempts: 1` on the data plane is deliberate: botocore's
# standard retry mode re-sends a ReadTimeoutError'd request itself, which would silently
# re-invoke a 1000 s turn (same session id) before the job runner ever saw the failure —
# the ONLY retry is `jobs_batch._replay_session`'s classified loop, which logs attempt k/N.
_CLIENT_CONFIGS: dict[str, Config] = {
    "bedrock-agentcore": Config(
        read_timeout=INVOKE_READ_TIMEOUT_S,
        connect_timeout=INVOKE_CONNECT_TIMEOUT_S,
        retries={"max_attempts": 1, "mode": "standard"},
    ),
}


def _client(service: str) -> Any:
    if CLIENT_FACTORY is not None:
        return CLIENT_FACTORY(service)
    if service not in _CLIENTS:
        _CLIENTS[service] = boto3.client(
            service, region_name=_REGION, config=_CLIENT_CONFIGS.get(service)
        )
    return _CLIENTS[service]


def _lambda_clients() -> Any:
    """N17-obs333: one Lambda client per code-evaluator timeout — read timeout =
    ``lambda_timeout_s`` + margin, a single attempt (``code_evaluators.lambda_config``)."""

    def make(timeout_s: int) -> Any:
        if CLIENT_FACTORY is not None:
            return CLIENT_FACTORY("lambda")
        return boto3.client("lambda", region_name=_REGION,
                            config=code_evaluators.lambda_config(timeout_s))

    return code_evaluators.LambdaClients(make)


def _env() -> jobs_batch.WorkerEnv:
    # N17-obs393: set from the preset spec env (eval_worker.CODE_EVALUATORS_ENV)
    code_enabled = os.environ.get("LAUNCHPAD_EVAL_CODE_EVALUATORS_ENABLED", "") == "1"
    return jobs_batch.WorkerEnv(
        logs_client=_client("logs"),
        data_client=_client("bedrock-agentcore"),
        judge_factory=judge_model,
        default_model_id=MODEL_ID,
        lambda_client=_lambda_clients() if code_enabled else None,
        code_evaluators_enabled=code_enabled,
        judge_concurrency=int(os.environ.get("LAUNCHPAD_EVAL_JUDGE_CONCURRENCY", "4")),
        judge_budget_cap=JUDGE_MAX_TOKENS_CAP,
        judge_budget=judge_budget,
        transient_backoff_s=TRANSIENT_RETRY_BACKOFF_S,
        # jobs_optimize writes candidate bundle versions (jobs_batch.OPTIONAL_HANDLERS)
        extra={"s3_client": _client("s3")},
    )


def _run(job: JobSpec, sink: JobSink, task_id: int) -> None:
    try:
        jobs_batch.run_job(job, sink, _env())
        if not sink.finished:
            sink.finish("COMPLETED")
    except Exception as exc:  # the job's crash is the job's failure, never the worker's
        if not sink.finished:
            sink.finish("FAILED", error=f"{type(exc).__name__}: {exc}"[:2000])
    finally:
        try:
            app.complete_async_task(task_id)
        except Exception:
            pass
        _THREADS.pop(job.job_id, None)


def _handle(payload: dict[str, Any], context: Any = None) -> dict[str, Any]:
    """Validate → status.json → async task → thread → ack (plan §B.0 job protocol)."""
    try:
        job = JobSpec.from_payload(payload)
    except KindUnsupportedError as exc:
        return {"job_id": payload.get("job_id"), "attempt": payload.get("attempt"),
                "state": "REJECTED", "code": exc.code, "message": str(exc)}
    except Exception as exc:  # noqa: BLE001 — a malformed payload is the caller's error
        return {"job_id": payload.get("job_id"), "attempt": payload.get("attempt"),
                "state": "REJECTED", "code": "evaluation.bad_payload",
                "message": f"{type(exc).__name__}: {exc}"[:500]}
    bucket = str(job.sink.get("bucket") or "")
    if not bucket:
        return {"job_id": job.job_id, "attempt": job.attempt, "state": "REJECTED",
                "code": "evaluation.bad_payload", "message": "sink.bucket is required"}
    # D21 (M1-d): the hub's descriptors of every catalog model this job names go in front of
    # the inlined provider / budget tables (`_model_provider`, `judge_budget`); a payload
    # without them (an older hub) leaves the tables in charge exactly as before.
    _launchpad_register_descriptors(job.models)
    sink = JobSink(S3Store(_client("s3"), bucket), job)
    # N12-bug8: resolve the judge's key HERE, on the request thread — the only thread that
    # sees the Runtime-injected workload token (the SDK's per-request contextvar; the hub
    # always sends runtimeUserId). strands-evals / asyncio run the evaluators on pools of
    # their own that do not inherit the context, so a lazy first exchange there found no
    # token, fell to self-mint and got Identity's "linked to a service" refusal on every
    # record. A key that cannot be obtained rejects the job now, readably, instead of
    # producing one identical evaluator error per record.
    try:
        _prefetch_judge_credential()
    except Exception as exc:  # noqa: BLE001 — infrastructure, not the job's doing
        message = f"{type(exc).__name__}: {exc}"[:2000]
        sink.status("invoking", message=f"worker rejected the job: {message}"[:500])
        sink.finish("FAILED", error=message, summary={"error_kind": "infrastructure"})
        return {"job_id": job.job_id, "attempt": job.attempt, "state": "REJECTED",
                "code": CREDENTIAL_CODE, "message": message,
                "worker": WORKER_NAME, "release": WORKER_RELEASE}
    sink.status("invoking", message="worker accepted the job")
    task_id = app.add_async_task(
        "launchpad-eval-job",
        {"job_id": job.job_id, "attempt": job.attempt, "job_type": job.job_type},
    )
    # N10v3-bug2 (same pattern as the Skill Lab worker): the job thread still runs inside a
    # copy of this request's context — harmless, and anything else request-scoped the
    # library reads (session id, headers) stays visible on the job's own thread.
    request_context = contextvars.copy_context()
    thread = threading.Thread(target=request_context.run, args=(_run, job, sink, task_id),
                              daemon=True, name=f"eval-job-{job.job_id}")
    _THREADS[job.job_id] = thread
    thread.start()
    return {"job_id": job.job_id, "attempt": job.attempt, "state": "ACCEPTED",
            "worker": WORKER_NAME, "release": WORKER_RELEASE}


handler = app.entrypoint(_handle)


if __name__ == "__main__":
    app.run()
