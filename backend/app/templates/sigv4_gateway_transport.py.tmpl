# Grafted into a converted twin's mcp_client/client.py by harness_convert.
# Runs in the RUNTIME with its execution role (not the platform), so it builds
# its own boto3 session. Needs boto3, httpx, SigV4Auth, AWSRequest and
# streamablehttp_client imported by the surrounding module.


class _LaunchpadSigV4Auth(httpx.Auth):
    """SigV4-sign each Gateway MCP request with the runtime role (AWS_IAM Gateway)."""

    requires_request_body = True

    def __init__(self, region):
        self._region = region
        self._session = boto3.Session()

    def auth_flow(self, request):
        credentials = self._session.get_credentials().get_frozen_credentials()
        signed = AWSRequest(
            method=request.method, url=str(request.url), data=request.content,
            headers={k: v for k, v in request.headers.items() if k.lower() != "connection"},
        )
        SigV4Auth(credentials, "bedrock-agentcore", self._region).add_auth(signed)
        request.headers.update(dict(signed.headers.items()))
        yield request


def _launchpad_sigv4_streamablehttp(url, region):
    return streamablehttp_client(url, auth=_LaunchpadSigV4Auth(region))
