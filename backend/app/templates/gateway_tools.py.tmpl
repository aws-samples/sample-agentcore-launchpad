# <launchpad-gateway-mcp:v1>
# Gateway MCP tools for a generated runtime whose spec carries a `gateway` ToolRef.
#
# FAIL-SOFT BY CONSTRUCTION, not by discipline. Nothing at module scope here can
# raise: the only statements are os.environ.get() reads and function definitions,
# and every import that could fail is function-local. A Gateway client that dies at
# import would be strictly worse than one that has no tools — the deploy pipeline
# would still see the runtime reach READY, so the agent would report `active` and
# then fail every single invoke. Missing tools degrade an answer; an import crash
# removes the agent.
#
# AWS_IAM Gateway, SigV4-signed with the runtime's own execution role (the
# shared launchpad-gw's authorizerType since N1; it has never accepted an OAuth
# bearer). agent_iam._uses_gateway()/`AgentCoreGatewayInvoke` already grants
# bedrock-agentcore:InvokeGateway on the referenced gateway id(s) — there is no
# token to mint, so there is nothing to fail softly on besides the HTTP call
# itself (handled in gateway_tools() below).

GATEWAY_URL = os.environ.get("LAUNCHPAD_GATEWAY_URL", "")
GATEWAY_REGION = os.environ.get("AWS_REGION", "cn-northwest-1")
GATEWAY_CONFIG = os.environ.get("LAUNCHPAD_GATEWAYS", "")
# fnmatch patterns of the Gateway tools this agent may load — the selected Registry
# records' targets only; unset (older deploys) keeps every tool
GATEWAY_TOOL_PATTERNS = [
    pattern for pattern in os.environ.get("LAUNCHPAD_GATEWAY_TOOLS", "").split(",") if pattern
]


def _gw_log(message: str) -> None:
    """Diagnostics land in the runtime log group; flush so a crash keeps them."""
    print(f"[launchpad-gateway] {message}", flush=True)


def gateway_client(url=None, region=None):
    """An unstarted MCPClient for a Gateway, or None. Never raises."""
    url, region = url or GATEWAY_URL, region or GATEWAY_REGION
    if not url:
        return None
    try:
        from mcp.client.streamable_http import streamablehttp_client
        from strands.tools.mcp import MCPClient

        return MCPClient(lambda: _launchpad_sigv4_streamablehttp(url, region))
    except Exception as exc:
        _gw_log(f"MCP client construction failed: {type(exc).__name__}: {exc}")
        return None


def _gw_stop(client) -> None:
    """Tear an MCP client down without ever raising.

    MCPClient runs its session on a background task group and re-raises that
    group's errors from ``__exit__``. Handing the raw client to
    ``ExitStack.enter_context`` therefore turns a *handled* mid-request failure
    into an unhandled one at stack unwind — the request 500s even though the tool
    loading was already caught (observed live: a `tools/list` 400 was logged and
    skipped, then `httpx.HTTPStatusError` escaped the ExitStack and failed the
    whole invocation). So teardown is registered as a guarded callback instead.
    """
    try:
        client.stop(None, None, None)
    except Exception as exc:
        _gw_log(f"gateway session teardown failed (ignored): {type(exc).__name__}: {exc}")


def gateway_tools(stack) -> list:
    """Gateway tools for this request, with teardown registered on ``stack``.

    The session must stay open for as long as the agent may call a tool, so the
    caller owns the stack. Returns [] on any failure, and cannot raise — including
    while the stack unwinds.
    """
    if GATEWAY_CONFIG:
        try:
            import json
            groups = json.loads(GATEWAY_CONFIG)
            tools = []
            for group in groups:
                url = group["url"]
                tools.extend(_gateway_tools(stack, gateway_client(url), url, group.get("tools", [])))
            return tools
        except Exception as exc:
            _gw_log(f"gateway configuration failed: {type(exc).__name__}: {exc}")
            return []
    return _gateway_tools(stack, gateway_client(), GATEWAY_URL, GATEWAY_TOOL_PATTERNS)


def _gateway_tools(stack, client, url, patterns) -> list:
    if client is None:
        return []
    try:
        client.start()
    except Exception as exc:
        _gw_log(f"gateway session start failed: {type(exc).__name__}: {exc}")
        _gw_stop(client)  # start() can fail partway through initialization
        return []
    stack.callback(_gw_stop, client)
    try:
        tools = list(client.list_tools_sync())
    except Exception as exc:
        _gw_log(f"tools/list against {url} failed: {type(exc).__name__}: {exc}")
        return []
    if patterns:
        from fnmatch import fnmatchcase

        tools = [
            t for t in tools
            if any(fnmatchcase(str(getattr(t, "tool_name", "")), p) for p in patterns)
        ]
    _gw_log(f"gateway tools loaded: {[getattr(t, 'tool_name', '?') for t in tools]}")
    return tools


# </launchpad-gateway-mcp:v1>
