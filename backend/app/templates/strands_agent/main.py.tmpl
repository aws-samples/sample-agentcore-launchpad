# The self-hosted memory library (S3 session snapshots · SQS extraction · OpenSearch
# recall) and the direct KB tools that reuse its OpenSearch/Titan clients. Both are
# env-driven and no-ops when the workspace has no substrate; the library needs the
# model block above (_resolve_bedrock_api_key / MODEL_REGION / BEDROCK_BEARER_ENV).
__LAUNCHPAD_MEMORY_SOURCE__


__LAUNCHPAD_DIRECT_KB_SOURCE__
# --- end CN memory/KB (N6) ---


def build_agent(
    actor_id: str,
    session_id: str,
    extra_tools: list | None = None,
    session_manager: Any | None = None,
) -> Agent:
    tools = list(TOOLKIT_TOOLS) or [calculator, current_utc_time]
    if MOUNTED_KBS:
        tools += [kb_search, kb_deep_search]
    # mounted A2A agents (empty list when none) — N11 r3-C
    tools += list(A2A_TOOLS)
    # Gateway MCP tools, discovered per request — they only exist while the MCP
    # session the caller opened is alive, so they arrive as an argument rather
    # than from a module global.
    tools += list(extra_tools or [])
    for t in tools:
        try:
            override = resolve_tool_description(t.tool_name)
            if not override:
                continue
            # An MCP-served tool derives tool_spec from its wrapped mcp_tool on
            # every access, so writing into that dict would be thrown away —
            # the description has to be set on the source object.
            mcp_tool = getattr(t, "mcp_tool", None)
            if mcp_tool is not None:
                mcp_tool.description = override
            else:
                t.tool_spec["description"] = override
        except Exception:
            pass  # tool spec immutable in this strands version — default docstring stands
    kwargs: dict[str, Any] = {
        "model": build_model(),
        "system_prompt": resolve_system_prompt(),
        "tools": tools,
    }
    if session_manager is None:
        session_manager = make_session_manager(actor_id, session_id)
    if session_manager is not None:
        kwargs["session_manager"] = session_manager
    plugins = skill_plugins()
    if plugins:
        kwargs["plugins"] = plugins
    # --- CN memory/KB (N6) ---
    # one turn → one snapshot event + one extraction message (no-op without a store)
    hooks = make_memory_hooks(actor_id, session_id)
    if hooks:
        kwargs["hooks"] = hooks
    # --- end CN memory/KB (N6) ---
    __LAUNCHPAD_PRINCIPAL_EXECUTOR__
    return Agent(**kwargs)


app = BedrockAgentCoreApp()
_launchpad_log = logging.getLogger("launchpad.runtime")

# Keep this frame larger than the backend's 32-byte SSE read chunk, and the
# interval shorter than any idle timeout between the Runtime and the console.
SSE_HEARTBEAT_INTERVAL_S = 15.0


async def _events_with_heartbeat(
    events: AsyncIterator[dict[str, Any]],
    interval_s: float = SSE_HEARTBEAT_INTERVAL_S,
) -> AsyncIterator[dict[str, Any]]:
    """Keep the response active while one task owns the agent's async generator.

    OpenTelemetry context tokens must be detached in the task that attached
    them, so a single producer task pumps the iterator into a queue while this
    consumer emits heartbeat frames during quiet periods (long tool calls).
    """
    iterator = events.__aiter__()
    queue: asyncio.Queue[tuple[str, Any]] = asyncio.Queue(maxsize=1)

    async def produce() -> None:
        try:
            async for event in iterator:
                await queue.put(("event", event))
        except asyncio.CancelledError:
            raise
        except BaseException as exc:
            await queue.put(("error", exc))
        else:
            await queue.put(("done", None))

    producer = asyncio.create_task(produce())
    try:
        while True:
            try:
                kind, value = await asyncio.wait_for(queue.get(), timeout=interval_s)
            except TimeoutError:
                yield {"event": "heartbeat", "timestamp": time.time()}
                continue
            if kind == "event":
                yield value
            elif kind == "error":
                raise value
            else:
                return
    finally:
        if not producer.done():
            producer.cancel()
            with suppress(asyncio.CancelledError):
                await producer
        close = getattr(iterator, "aclose", None)
        if close is not None:
            await close()


# <launchpad-max-tokens:v1>  # --- CN N-SCN-bug4 ---
# Strands raises MaxTokensReachedException (unwrapped) when one completion stops on
# `max_tokens`; the partial assistant message is already in the agent's history, so the
# documented recovery is to call the agent again. Without this the AgentCore SDK turns the
# exception into a terminal `{"error": ...}` frame and the console loses the turn. The
# already-streamed partial text stays; a `truncated` marker separates it from the
# continuation; a turn that still cannot finish ends with a visible notice, a normal
# `complete` carrying `truncated: true` and the marker - never an error. Bounded by
# LAUNCHPAD_MAX_TOKENS_CONTINUATIONS (default 1; 0 = notice only, never continue).
# Same semantics as the Harness template (harness_runtime/main.py.tmpl).
LAUNCHPAD_MAX_TOKENS_CONTINUATION_PROMPT = (
    "Your previous answer was cut off at the token limit. "
    "Finish it concisely - final answer only."
)
LAUNCHPAD_MAX_TOKENS_NOTICE = "[response truncated at the model's token limit]"


def _launchpad_max_tokens_continuations() -> int:
    raw = os.environ.get("LAUNCHPAD_MAX_TOKENS_CONTINUATIONS", "1")
    try:
        return max(0, int(raw))
    except ValueError:
        return 1


def _launchpad_is_max_tokens(exc: BaseException) -> bool:
    """Matched by class name: the exception lives in strands.types.exceptions today and
    the SDK is a moving preview target, so no import is required to recognise it."""
    return any(klass.__name__ == "MaxTokensReachedException" for klass in type(exc).__mro__)


def _launchpad_output_tokens(event: dict[str, Any]) -> int | None:
    raw = event.get("event")
    if not isinstance(raw, dict):
        return None
    usage = raw.get("metadata", {}).get("usage", {})
    tokens = usage.get("outputTokens") if isinstance(usage, dict) else None
    return tokens if isinstance(tokens, int) else None


def _launchpad_continuation_max_tokens() -> int:
    """N-SCN-bug4 (5): the lower output cap a continuation call uses; 0 = the model's own."""
    raw = os.environ.get("LAUNCHPAD_CONTINUATION_MAX_TOKENS", "0")
    try:
        return max(0, int(raw))
    except ValueError:
        return 0


def _launchpad_cap_max_tokens(agent: Any, cap: int) -> Any:
    """Lower the agent model's max_tokens to `cap` for one continuation; returns the
    callable that restores the previous value. Works on both Strands model families:
    BedrockModel keeps `max_tokens` at the top of its config, OpenAIModel inside `params`.
    Any other model is left untouched. Same helper as the Harness template."""
    model = getattr(agent, "model", None)
    get_config = getattr(model, "get_config", None)
    update_config = getattr(model, "update_config", None)
    if cap <= 0 or get_config is None or update_config is None:
        return lambda: None
    try:
        config = dict(get_config() or {})
        if isinstance(config.get("params"), dict):
            before = dict(config["params"])
            update_config(params={**before, "max_tokens": cap})
            return lambda: update_config(params=before)
        before_cap = config.get("max_tokens")
        update_config(max_tokens=cap)
        return lambda: update_config(max_tokens=before_cap)
    except Exception as exc:  # a model that refuses the update keeps its own cap
        _launchpad_log.warning("continuation cap not applied: %s: %s", type(exc).__name__, exc)
        return lambda: None
# </launchpad-max-tokens:v1>


# <launchpad-tool-summaries:v1>  # --- CN N16-obs85 ---
# Bounded tool-call summaries for the console. Strands yields one `message` event when the
# assistant message (its `toolUse` blocks carry the complete arguments) and the tool-result
# message (`toolResult` blocks) join the conversation; each block becomes one additive
# `tool_input` / `tool_result` frame. Every field is cut at a fixed size - never a tool's
# full output, never a page's text (the browser builtin's result is reduced to its title,
# final URL and text length). A hub that does not know these frames ignores them.
import json as _launchpad_json
import re as _launchpad_re

LAUNCHPAD_TOOL_INPUT_CHARS = 512
LAUNCHPAD_TOOL_RESULT_CHARS = 256
# C4 (rev-r16): a `<name>=<value>` / `<name>: <value>` pair whose name smells like a credential
# is reduced to `<name>=[redacted]` before anything is cut; the native shell / file tools get
# NO result summary at all (their output is arbitrary host text) - status only.
_LAUNCHPAD_SECRET_RE = _launchpad_re.compile(
    r"\b(\w*(?:token|secret|password|bearer|credential|authorization)\w*|\w*key)\b"
    r"[\"']?\s*[=:]\s*(?:[\"'][^\"']*[\"']|\S+)"
    r"|\b(bearer)\s+\S+",
    _launchpad_re.IGNORECASE,
)
LAUNCHPAD_UNSUMMARISED_TOOLS = frozenset({"shell", "file_operations"})
_LAUNCHPAD_TOOL_NAMES = {}  # toolUseId -> tool name, from the assistant's toolUse blocks


def _launchpad_redact(text):
    return _LAUNCHPAD_SECRET_RE.sub(lambda m: f"{m.group(1) or m.group(2)}=[redacted]", text)


def _launchpad_bounded(text, limit):
    text = _launchpad_redact(" ".join(str(text if text is not None else "").split()))
    if len(text) <= limit:
        return text
    return text[:limit] + f"... [+{len(text) - limit} chars]"


def _launchpad_result_text(result):
    parts = []
    for item in result.get("content") or []:
        if not isinstance(item, dict):
            continue
        if isinstance(item.get("text"), str):
            parts.append(item["text"])
        elif "json" in item:
            parts.append(_launchpad_json.dumps(item["json"], ensure_ascii=False, default=str))
        elif "image" in item:
            parts.append("[image]")
        elif "document" in item:
            parts.append("[document]")
    return "\n".join(parts)


def _launchpad_result_summary(result):
    """`title: ... | url: ... | text: N chars` for the browser builtin's `title / url /
    blank / text` result shape (the page text itself is never summarised); otherwise the
    first LAUNCHPAD_TOOL_RESULT_CHARS characters of the result text."""
    text = _launchpad_result_text(result)
    lines = text.split("\n", 3)
    if len(lines) >= 3 and lines[0].startswith("title: ") and lines[1].startswith("url: "):
        body = lines[3] if len(lines) > 3 else ""
        return _launchpad_bounded(
            f"{lines[0]} | {lines[1]} | text: {len(body)} chars", LAUNCHPAD_TOOL_RESULT_CHARS
        )
    return _launchpad_bounded(text, LAUNCHPAD_TOOL_RESULT_CHARS)


def _launchpad_tool_frames(event):
    """The `tool_input` / `tool_result` frames one Strands stream event carries (0..n)."""
    message = event.get("message") if isinstance(event, dict) else None
    if not isinstance(message, dict):
        return []
    frames = []
    for block in message.get("content") or []:
        if not isinstance(block, dict):
            continue
        use = block.get("toolUse")
        if isinstance(use, dict) and use.get("name"):
            arguments = _launchpad_json.dumps(use.get("input"), ensure_ascii=False, default=str)
            tool_id = str(use.get("toolUseId") or "") or None
            if tool_id:
                _LAUNCHPAD_TOOL_NAMES[tool_id] = str(use["name"])
            frames.append({
                "event": "tool_input", "id": tool_id, "name": str(use["name"]),
                "input": _launchpad_bounded(arguments, LAUNCHPAD_TOOL_INPUT_CHARS),
            })
        result = block.get("toolResult")
        if isinstance(result, dict):
            tool_id = str(result.get("toolUseId") or "") or None
            name = _LAUNCHPAD_TOOL_NAMES.pop(tool_id, "") if tool_id else ""
            frames.append({
                "event": "tool_result", "id": tool_id, "name": name,
                "status": str(result.get("status") or ""),
                "summary": (
                    "" if name in LAUNCHPAD_UNSUMMARISED_TOOLS
                    else _launchpad_result_summary(result)
                ),
            })
    return frames
# </launchpad-tool-summaries:v1>


async def agent_events(agent: Agent, prompt: str | list) -> AsyncIterator[dict[str, Any]]:
    """Map Strands ``stream_async`` events onto the platform's runtime envelope.

    ``data`` text chunks become ``delta``; the first sight of each tool use
    (``current_tool_use`` or the raw ``contentBlockStart``) becomes one ``tool``
    event; the final ``AgentResult`` closes the turn as ``complete``. The
    platform (``rt._runtime_payload_events``) parses this identically to the
    Claude SDK container stream and to InvokeHarness's content blocks.

    A ``max_tokens`` stop (N-SCN-bug4) is recovered here, see the block above:
    ``truncated`` marker → one bounded continuation → notice + ``complete``
    ``{truncated: true}`` when the turn still cannot finish.
    """
    seen_tool_ids: set[str] = set()
    result: Any = None
    streamed: list[str] = []
    output_tokens: int | None = None
    budget = _launchpad_max_tokens_continuations()
    cap = _launchpad_continuation_max_tokens()
    attempts = 0
    truncated = False
    next_prompt: str | list = prompt
    while True:
        # the continuation (attempts > 0) runs under the lower output cap, if one is set
        restore_cap = _launchpad_cap_max_tokens(agent, cap) if attempts else (lambda: None)
        try:
            async for event in agent.stream_async(next_prompt):
                if not isinstance(event, dict):
                    continue
                for tool_frame in _launchpad_tool_frames(event):  # N16-obs85
                    yield tool_frame
                tokens = _launchpad_output_tokens(event)
                if tokens is not None:
                    output_tokens = tokens
                # GLM 5.3 / Kimi K3 stream `reasoningContent` before the answer (spec C3: ignored)
                if event.get("reasoning") or "reasoningText" in event:
                    continue
                text = event.get("data")
                if isinstance(text, str) and text:
                    streamed.append(text)
                    yield {"event": "delta", "text": text}
                tool_use = event.get("current_tool_use")
                if not isinstance(tool_use, dict):
                    raw = event.get("event")
                    if isinstance(raw, dict):
                        tool_use = raw.get("contentBlockStart", {}).get("start", {}).get("toolUse")
                if isinstance(tool_use, dict) and tool_use.get("name"):
                    tool_id = str(tool_use.get("toolUseId") or "")
                    key = tool_id or str(tool_use["name"])
                    if key not in seen_tool_ids:
                        seen_tool_ids.add(key)
                        yield {"event": "tool", "name": str(tool_use["name"]), "id": tool_id or None}
                if "result" in event:
                    result = event["result"]
            truncated = False
        except Exception as exc:
            if not _launchpad_is_max_tokens(exc):
                raise
            truncated = True
            _launchpad_log.warning(
                "max_tokens stop: stop_reason=max_tokens output_tokens=%s continuation=%d/%d "
                "streamed_chars=%d continuation_cap=%d",
                output_tokens, attempts, budget, sum(len(t) for t in streamed), cap,
            )
            if attempts < budget:
                attempts += 1
                yield {"event": "truncated", "truncated": False, "stop_reason": "max_tokens",
                       "continuations": attempts}
                if streamed:
                    streamed.append("\n")
                    yield {"event": "delta", "text": "\n"}
                next_prompt = LAUNCHPAD_MAX_TOKENS_CONTINUATION_PROMPT
                continue
        finally:
            try:  # a failing restore must never mask the turn's own outcome
                restore_cap()
            except Exception as restore_exc:
                _launchpad_log.warning("continuation cap not restored: %s: %s",
                            type(restore_exc).__name__, restore_exc)
        break
    if attempts == 0 and not truncated:
        yield {"event": "complete", "result": str(result) if result is not None else ""}
        return
    # a continued or truncated turn: the answer is what the console already saw; a
    # continuation that finished on its own stop (end_turn) is a normal turn even when it
    # produced no text (r7-e) - the notice and `truncated: true` are for a max_tokens stop only
    text = "".join(streamed).strip()
    if truncated:
        notice = ("\n\n" if text else "") + LAUNCHPAD_MAX_TOKENS_NOTICE
        yield {"event": "delta", "text": notice}
        yield {"event": "truncated", "truncated": True, "stop_reason": "max_tokens",
               "continuations": attempts}
        yield {"event": "complete", "result": text + notice, "truncated": True}
        return
    yield {"event": "complete", "result": text}


async def _turn_events(
    payload: dict[str, Any], prompt: str, session_id: str
) -> AsyncIterator[dict[str, Any]]:
    actor_id = str(payload.get("actor_id", "default"))
    # The Gateway MCP session must stay open for as long as the agent may call one
    # of its tools, so it is scoped to the whole turn. GATEWAY_TOOLS is a no-op
    # returning [] for a spec with no gateway tool.
    with ExitStack() as stack:
        session_manager = memory_session_manager(actor_id, session_id)
        # --- CN memory/KB (N6) ---
        # Strands' S3SessionManager persists each message as it is appended and is not
        # a context manager; a batched manager a graft may still supply flushes on
        # close, so only one that defines __enter__ is scoped to the turn.
        if session_manager is not None and hasattr(session_manager, "__enter__"):
            stack.enter_context(session_manager)
        # --- end CN memory/KB (N6) ---
        # as_user revocations the platform asks this turn to honor
        force_reauth = payload.get("force_reauth_providers") or []
        # peers keep their own conversation per (this session, peer) — N11 r3-C; the
        # actor is the runtimeUserId every peer invoke carries (N10v3-bug5 correction)
        a2a_bind_session(session_id, actor_id)
        agent = build_agent(
            actor_id,
            session_id,
            GATEWAY_TOOLS(stack)
            + IDENTITY_TOOLS(stack, session_id, force_reauth),
            session_manager=session_manager,
        )
        known = recall_context(actor_id, prompt)
        if known:
            agent.system_prompt = f"{resolve_system_prompt()}\n\nKnown user context:\n{known}"
        model_input = _launchpad_strands_input(prompt, payload.get("attachments"))
        if payload.get("attachments"):
            yield {"event": "attachments", "contract": "v1"}
        # an as_user MCP tool asks at load time (its session cannot open
        # without the user's token) — surface that before the answer starts
        for notice in IDENTITY_AUTH_NOTICES():
            yield {"event": "auth_required", **notice}
        async for event in agent_events(agent, model_input):
            yield event
            # an as_user rest tool asks inside the tool call — drain after
            # every event so the card renders live
            for notice in IDENTITY_AUTH_NOTICES():
                yield {"event": "auth_required", **notice}


@app.entrypoint
async def invoke(
    payload: dict[str, Any], context: Any = None
) -> AsyncIterator[dict[str, Any]]:
    _launchpad_capture_bundle_ref(payload)  # CA-2 channel 3: payload["launchpad"]["bundle"]
    prompt = str(payload.get("prompt", "")).strip()
    if not prompt and not payload.get("attachments"):
        yield {"event": "error", "message": "payload must include a non-empty 'prompt'"}
        return
    session_id = str(getattr(context, "session_id", "") or payload.get("session_id", "") or "adhoc")
    turn = _turn_events(payload, prompt, session_id)
    __LAUNCHPAD_PRINCIPAL_CAPTURE__
    async for event in _events_with_heartbeat(turn, SSE_HEARTBEAT_INTERVAL_S):
        yield event


if __name__ == "__main__":
    app.run()
