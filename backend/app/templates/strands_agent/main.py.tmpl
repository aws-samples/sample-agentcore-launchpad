_BEDROCK_API_KEY: dict[str, str] = {}
# N-R6: keys of the OTHER providers (OpenAI-compatible endpoints), per credential provider.
_PROVIDER_API_KEYS: dict[str, str] = {}
# The Runtime-injected workload token, captured ON THE REQUEST PATH into a process slot:
# the A2A server's middleware copies it off the request header, the evaluation worker
# copies it out of the SDK's per-request context before it spawns the job thread
# (`_capture_workload_token`). Threads that never see that context — strands-evals' /
# asyncio's own pools, the A2A executor — read this slot. The HTTP runtime and the
# Harness never write it and read the context directly.
_WORKLOAD_TOKEN: dict[str, str] = {}
# N12-bug8 / N10v3-bug5 (live correction): a RUNTIME-LINKED workload identity cannot mint
# its own token — Identity answers ValidationException "WorkloadIdentity is linked to a
# service and cannot retrieve an access token by the caller". Self-mint on
# LAUNCHPAD_WORKLOAD_NAME is therefore a last resort tried ONCE per process; after that
# refusal the branch is disabled and a token-less request fails fast with the real cause
# instead of hammering Identity from every judge / tool call.
_SELF_MINT: dict[str, str] = {}
_SELF_MINT_REFUSAL = "cannot retrieve an access token"


def _identity_client():
    from bedrock_agentcore.services.identity import IdentityClient

    return IdentityClient(os.environ.get("AWS_REGION", "cn-northwest-1"))


def _capture_workload_token() -> str | None:
    """Request-path hook: copy the Runtime-injected token (the invoke carried runtimeUserId)
    out of the SDK's per-request context into the process slot, so a thread without that
    context still finds it. Returns the token now known to the process, if any."""
    try:
        injected = BedrockAgentCoreContext.get_workload_access_token()
    except Exception:
        injected = None
    if injected:
        _WORKLOAD_TOKEN["value"] = injected
    return _WORKLOAD_TOKEN.get("value") or None


def _self_mint_workload_token(workload: str) -> str | None:
    """Last resort: GetWorkloadAccessToken for this runtime's own identity. Works only for
    an identity NOT linked to the Runtime; the linked-identity refusal disables the branch
    for the rest of the process (no retry storm) and returns None."""
    if _SELF_MINT.get("disabled"):
        return None
    try:
        return _identity_client().get_workload_access_token(workload)["workloadAccessToken"]
    except Exception as exc:
        code = str((getattr(exc, "response", None) or {}).get("Error", {}).get("Code", ""))
        if "linked to a service" in str(exc) or (
            code == "ValidationException" and _SELF_MINT_REFUSAL in str(exc)
        ):
            _SELF_MINT["disabled"] = "linked"
            return None
        raise


def _workload_access_token() -> str | None:
    """Captured token first (the request path wrote the freshest one), then the
    Runtime-injected token straight from the SDK context; self-mint on
    LAUNCHPAD_WORKLOAD_NAME only as a last resort (see `_self_mint_workload_token`)."""
    captured = _WORKLOAD_TOKEN.get("value")
    if captured:
        return captured
    try:
        injected = BedrockAgentCoreContext.get_workload_access_token()
    except Exception:
        injected = None
    if injected:
        return injected
    workload = os.environ.get("LAUNCHPAD_WORKLOAD_NAME", "")
    if not workload:
        return None
    return _self_mint_workload_token(workload)


def _no_workload_token_error() -> RuntimeError:
    if _SELF_MINT.get("disabled"):
        return RuntimeError(
            "no workload access token: this runtime's workload identity is linked to the "
            "AgentCore Runtime and cannot self-mint one (Identity refused "
            "GetWorkloadAccessToken for LAUNCHPAD_WORKLOAD_NAME) — the caller must send "
            "runtimeUserId so the Runtime injects the token into the request"
        )
    return RuntimeError(
        "no workload access token: the invoke must carry runtimeUserId (the platform "
        "always sends it) — a runtime-linked workload identity cannot self-mint one, so "
        "LAUNCHPAD_WORKLOAD_NAME is only a last resort for an unlinked identity"
    )


def _resolve_bedrock_api_key() -> str:
    """The Global Bedrock API key from MODEL_CREDENTIAL, fetched once per process.

    Raises instead of returning "" — a model call without the key would fail with an
    opaque signing error against the Global endpoint. Resolve it on the REQUEST thread
    (`_prefetch_bedrock_api_key`) when later work runs on threads of its own.
    """
    cached = _BEDROCK_API_KEY.get("key")
    if cached:
        return cached
    token = _workload_access_token()
    if not token:
        raise _no_workload_token_error()
    response = _identity_client().dp_client.get_resource_api_key(
        workloadIdentityToken=token, resourceCredentialProviderName=MODEL_CREDENTIAL
    )
    key = str(response.get("apiKey") or "")
    if not key:
        raise RuntimeError(f"GetResourceApiKey({MODEL_CREDENTIAL}) returned no apiKey")
    _BEDROCK_API_KEY["key"] = key
    return key


def _resolve_api_key(credential_provider: str) -> str:
    """N-R6: any provider's API key from the Identity API-key provider `credential_provider`,
    fetched once per process through the same workload-token exchange as the Bedrock key
    (which keeps its own slot above). Never exported to the environment — an
    OpenAI-compatible model takes it as a client argument."""
    if credential_provider == MODEL_CREDENTIAL:
        return _resolve_bedrock_api_key()
    cached = _PROVIDER_API_KEYS.get(credential_provider)
    if cached:
        return cached
    token = _workload_access_token()
    if not token:
        raise _no_workload_token_error()
    response = _identity_client().dp_client.get_resource_api_key(
        workloadIdentityToken=token, resourceCredentialProviderName=credential_provider
    )
    key = str(response.get("apiKey") or "")
    if not key:
        raise RuntimeError(f"GetResourceApiKey({credential_provider}) returned no apiKey")
    _PROVIDER_API_KEYS[credential_provider] = key
    return key


# D21 (M1-d): resolved model descriptors by model id — the rendered one for MODEL_ID, any the
# environment carries (MODEL_DESCRIPTOR_ENV) and, in the evaluation worker, the ones each job
# payload brings (`models`). Read before the inlined MODEL_PROVIDERS / MODEL_INFERENCE_PARAMS
# tables, so a catalog edit reaches a worker through its job and a runtime through its env
# without a re-render; the tables stay the fallback for every other id.
MODEL_DESCRIPTORS: dict[str, dict[str, Any]] = {}


def _launchpad_register_descriptors(descriptors: Any) -> int:
    """Register one descriptor, a list of them or a ``{model_id: descriptor}`` map; for the
    same model id a strictly newer ``catalog_version`` wins, an equal one replaces (so an
    operator override beats the rendered row). Returns how many were kept."""
    if not descriptors:
        return 0
    if isinstance(descriptors, dict) and "model_id" in descriptors:
        items: list[Any] = [descriptors]
    elif isinstance(descriptors, dict):
        items = list(descriptors.values())
    else:
        items = list(descriptors)
    kept = 0
    for item in items:
        if not isinstance(item, dict) or not item.get("model_id"):
            continue
        model_id = str(item["model_id"])
        current = MODEL_DESCRIPTORS.get(model_id)
        if current is not None and int(current.get("catalog_version") or 0) > int(
            item.get("catalog_version") or 0
        ):
            continue
        MODEL_DESCRIPTORS[model_id] = dict(item)
        kept += 1
    return kept


def _launchpad_env_descriptors() -> Any:
    """The MODEL_DESCRIPTOR_ENV JSON (one descriptor / a list / a map), or None when unset;
    a malformed value is a loud error at import, never a silent fallback."""
    import json

    raw = os.environ.get(MODEL_DESCRIPTOR_ENV, "").strip()
    if not raw:
        return None
    try:
        return json.loads(raw)
    except ValueError as exc:
        raise RuntimeError(f"{MODEL_DESCRIPTOR_ENV} is not valid JSON: {exc}") from exc


_launchpad_register_descriptors(MODEL_DESCRIPTOR)
_launchpad_register_descriptors(_launchpad_env_descriptors())


def _model_provider(model_id: str) -> dict[str, Any]:
    """The provider row for `model_id`: its registered descriptor (D21) first, else the
    MODEL_PROVIDERS row; a model outside both is Bedrock (the historical path)."""
    descriptor = MODEL_DESCRIPTORS.get(model_id)
    if descriptor is not None:
        return descriptor
    return MODEL_PROVIDERS.get(model_id) or {
        "kind": "bedrock", "base_url": None, "api_model_name": model_id,
        "credential_provider": MODEL_CREDENTIAL, "streaming": True,
    }


def _resolve_model_api_key(model_id: str | None = None) -> str:
    """The key THIS runtime's model (or `model_id`) needs — Bedrock's or its provider's."""
    return _resolve_api_key(str(_model_provider(model_id or MODEL_ID)["credential_provider"]))


def _prefetch_bedrock_api_key() -> str:
    """Request-thread hook (N12-bug8): capture the injected token, then resolve and cache
    the key MODEL_ID needs so threads that never see the request context — judge pools, the
    A2A executor — find both without touching Identity. (Name kept from the Bedrock-only
    days; it resolves whichever provider's key the runtime's model is served by.)"""
    _capture_workload_token()
    return _resolve_model_api_key()


def _supported_model_config(config: dict[str, Any]) -> dict[str, Any]:
    """``config`` without the inference parameters this model rejects (N12-bug11): its
    registered descriptor's `inference_params` (D21) first, else the MODEL_INFERENCE_PARAMS
    table; a model outside both keeps every field."""
    model_id = str(config.get("model_id") or "")
    accepts: Any = (MODEL_DESCRIPTORS.get(model_id) or {}).get("inference_params")
    if not isinstance(accepts, dict):
        accepts = MODEL_INFERENCE_PARAMS.get(model_id, {})
    return {key: value for key, value in config.items() if accepts.get(key, True)}


def _launchpad_bedrock_model(*, api_key: str, **config: Any) -> Any:
    """``BedrockModel(api_key=…)`` for Strands 1.47, which has no api_key kwarg: botocore
    reads the bearer from the environment when the bedrock-runtime client is created,
    so export it first, then construct — minus the fields the model rejects."""
    os.environ[BEDROCK_BEARER_ENV] = api_key
    return BedrockModel(**_supported_model_config(config))


def _launchpad_openai_model(*, api_key: str, base_url: str, model_id: str,
                            api_model_name: str, streaming: bool = True, **config: Any) -> Any:
    """``OpenAIModel`` on an OpenAI-compatible endpoint (N-R6: SiliconFlow …). The key is a
    client argument only — never written to the environment or disk; `config` (max_tokens,
    temperature …) becomes the chat-completions body minus the fields MODEL_INFERENCE_PARAMS
    says this model rejects, exactly like the Bedrock path."""
    if OpenAIModel is None:
        raise RuntimeError(
            "strands-agents[openai] is not installed in this runtime — the platform "
            "requirements carry the extra; redeploy the agent"
        )
    params = _supported_model_config({"model_id": model_id, **config})
    params.pop("model_id", None)
    return OpenAIModel(
        client_args={"base_url": base_url, "api_key": api_key},
        model_id=api_model_name,
        params=params,
        stream=streaming,
    )


def _launchpad_chat_model(*, model_id: str, **config: Any) -> Any:
    """The one dispatch every runtime model goes through (N-R6): the catalog's provider row
    decides between the Global Bedrock profile (bearer from MODEL_CREDENTIAL) and an
    OpenAI-compatible endpoint (its own Identity credential provider). Either way the
    model normalizes every tool spec it is handed (N17-obs302)."""
    provider = _model_provider(model_id)
    if provider["kind"] == "openai_compatible":
        model = _launchpad_openai_model(
            api_key=_resolve_api_key(str(provider["credential_provider"])),
            base_url=str(provider["base_url"]),
            model_id=model_id,
            api_model_name=str(provider["api_model_name"]),
            streaming=bool(provider.get("streaming", True)),
            **config,
        )
    else:
        model = _launchpad_bedrock_model(
            api_key=_resolve_bedrock_api_key(),
            model_id=model_id,
            region_name=MODEL_REGION,
            **config,
        )
    return launchpad_normalize_model_tool_schemas(model)


def build_model() -> Any:
    """Model to hand to ``Agent(model=...)`` — MODEL_ID on its provider with the key."""
    return _launchpad_chat_model(model_id=MODEL_ID, max_tokens=MODEL_MAX_TOKENS)
# </launchpad-model-helpers>


def skill_plugins() -> list:
    """Enable progressive Skill loading only when packaging produced a bundle."""
    if not SKILLS_ENABLED or not SKILLS_ROOT.is_dir():
        return []
    if not any(
        child.is_dir() and (child / "SKILL.md").is_file()
        for child in SKILLS_ROOT.iterdir()
    ):
        return []
    from strands import AgentSkills

    return [AgentSkills(skills=str(SKILLS_ROOT))]


