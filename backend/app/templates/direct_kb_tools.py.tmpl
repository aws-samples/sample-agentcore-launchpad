"""Launchpad direct knowledge-base tools (self-hosted OpenSearch, N6).

Rendered from one source for both generated Strands ZIP entrypoints and converted
Harness bundles. Retrieval is a k-NN query against the knowledge base's own OpenSearch
index (`launchpad-kb-<id>`, `launchpad-<env>-kb-<id>` in a named environment — D17), signed
with the runtime execution role (ruling R10 — no
Bedrock Knowledge Base, no FM query planner); the query is embedded with the same Titan
client and Global Bedrock API key the memory library resolved for the agent's model.
The OpenSearch host comes from LAUNCHPAD_KB_OS_ENDPOINT, the region from AWS_REGION.
"""

import os
import re

from strands import tool

MOUNTED_KBS: list[dict[str, str]] = __LAUNCHPAD_MOUNTED_KBS__
KB_RESULTS = __LAUNCHPAD_KB_RESULTS__
KB_DEEP_RESULTS = KB_RESULTS * 2


def _kb_lib() -> dict:
    """Where the shared OpenSearch/Titan helpers live: this module's own globals when the
    source is inlined under the memory library in a generated main.py, else the sibling
    ``launchpad_memory`` module a converted Harness bundle carries beside this file."""
    if "OpenSearchHttp" in globals():
        return globals()
    import launchpad_memory

    return vars(launchpad_memory)


def _kb_opensearch():
    lib = _kb_lib()
    clients = lib["_MEMORY_CLIENTS"]
    if "kb_os" not in clients:
        clients["kb_os"] = lib["OpenSearchHttp"](
            os.environ.get("LAUNCHPAD_KB_OS_ENDPOINT", ""),
            os.environ.get("AWS_REGION", "cn-northwest-1"),
            lib["_memory_credentials"],
        )
    return clients["kb_os"]


def _kb_embedder():
    return _kb_lib()["_memory_embedder"]()


def _kb_index(kb_id: str) -> str:
    # D17: the library resolves the environment prefix (LAUNCHPAD_ENV_NAME) once.
    return _kb_lib()["launchpad_kb_index"](kb_id)


def _format_passages(kb_name: str, hits: list[dict]) -> str:
    if not hits:
        return f"[{kb_name}] no matching passages."
    lines = [f"[{kb_name}] {len(hits)} passage(s):"]
    for index, hit in enumerate(hits, start=1):
        header = f"{index}."
        score = hit.get("_score")
        if score is not None:
            header += f" score={float(score):.4f}"
        source = hit.get("doc_uri") or hit.get("doc_name") or ""
        if source:
            header += f" · source={source}"
        lines.append(f"{header}\n{str(hit.get('text') or '').strip()}")
    return "\n".join(lines)


def _knn(kb: dict[str, str], query: str, k: int) -> list[dict]:
    """One k-NN query against this knowledge base's index, filtered to its kb_id."""
    vector = _kb_embedder().embed(query)
    return _kb_opensearch().knn_search(
        _kb_index(kb["kb_id"]), vector, k, [{"term": {"kb_id": kb["kb_id"]}}]
    )


def _retrieve_one(kb: dict[str, str], query: str, k: int = KB_RESULTS) -> str:
    """One search, failures folded into the returned text — a broken or unauthorized
    knowledge base must never abort the turn."""
    try:
        hits = _knn(kb, query, k)
    except Exception as exc:
        return f"[{kb['name']}] search failed: {type(exc).__name__}: {exc}"
    return _format_passages(kb["name"], hits)


def _kb_targets(kb_id: str) -> list[dict[str, str]] | str:
    """Resolve which mounted KBs a call addresses, or an error string. Shared by
    both retrieval tools so they refuse unknown ids identically."""
    if not MOUNTED_KBS:
        return "no knowledge bases are mounted on this agent."
    if not kb_id:
        return MOUNTED_KBS
    targets = [kb for kb in MOUNTED_KBS if kb["kb_id"] == kb_id]
    if not targets:
        mounted = ", ".join(kb["kb_id"] for kb in MOUNTED_KBS)
        return f"knowledge base '{kb_id}' is not mounted. Mounted: {mounted}."
    return targets


@tool
def kb_search(query: str, kb_id: str = "") -> str:
    """Search the mounted knowledge bases with one k-NN similarity search per
    knowledge base and return the matching passages with their source.

    Fast and cheap — prefer it for a single fact you can name. Leave kb_id empty
    to search every mounted knowledge base; pass one kb_id to target a single one.
    """
    targets = _kb_targets(kb_id)
    if isinstance(targets, str):
        return targets
    if not query.strip():
        return "kb_search needs a non-empty query."
    return "\n\n".join(_retrieve_one(kb, query) for kb in targets)


_CLAUSE_SPLIT = re.compile(r"[;?!]|,\s|\band\b")


def _sub_queries(query: str) -> list[str]:
    """The question's clauses (split on ; ? ! , and 'and'), longer than three
    characters and distinct from the whole question."""
    whole = query.strip()
    out: list[str] = []
    for part in _CLAUSE_SPLIT.split(whole):
        part = part.strip()
        if len(part) > 3 and part != whole and part not in out:
            out.append(part)
    return out


def _deep_one(kb: dict[str, str], queries: list[str]) -> str:
    best: dict[tuple, dict] = {}
    try:
        for query in queries:
            for hit in _knn(kb, query, KB_DEEP_RESULTS):
                key = (hit.get("doc_uri"), hit.get("chunk_index"))
                score = hit.get("_score") or 0.0
                if key not in best or score > (best[key].get("_score") or 0.0):
                    best[key] = hit
    except Exception as exc:
        return f"[{kb['name']}] search failed: {type(exc).__name__}: {exc}"
    hits = sorted(best.values(), key=lambda h: h.get("_score") or 0.0, reverse=True)
    return _format_passages(kb["name"], hits[:KB_DEEP_RESULTS])


@tool
def kb_deep_search(query: str, kb_id: str = "") -> str:
    """Deep-search the mounted knowledge bases with a multi-query similarity pass.

    Runs the whole question plus up to three of its clauses as separate k-NN
    searches with a wider result set, de-duplicates the passages and returns the
    best-scoring ones with their sources. Slower than kb_search — use it for
    comparisons, exhaustive lists, or evidence spread across documents. Leave
    kb_id empty to search every mounted knowledge base.
    """
    targets = _kb_targets(kb_id)
    if isinstance(targets, str):
        return targets
    if not query.strip():
        return "kb_search needs a non-empty query."  # one message for both tools (kb-runtime.md)
    queries = [query.strip()] + _sub_queries(query)[:3]
    return "\n\n".join(_deep_one(kb, queries) for kb in targets)
