{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launchpad.policy.contracts/gateway_bundle_pointer/v1",
  "title": "I3 bundle pointer s3://<artifacts>/policy/gateway/<gateway_id>/current.json (amendment 3); the v<n>.json it names is immutable",
  "type": "object",
  "properties": {
    "schema": {
      "const": "launchpad.policy.gateway-pointer/1"
    },
    "gateway_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "key": {
      "type": "string",
      "pattern": "^policy/gateway/[^/]+/v[0-9]+\\.json$"
    },
    "issued_at": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "gateway_id",
    "version",
    "key",
    "issued_at"
  ],
  "additionalProperties": false
}
