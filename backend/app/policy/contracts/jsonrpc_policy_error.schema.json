{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launchpad.policy.contracts/jsonrpc_policy_error/v1",
  "title": "I8 JSON-RPC error the interceptor short-circuits with (deny / session required / conflict)",
  "type": "object",
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": ["string", "integer", "null"]},
    "error": {
      "type": "object",
      "properties": {
        "code": {"enum": [-32002, -32602]},
        "message": {
          "anyOf": [
            {"type": "string", "pattern": "^Tool Execution Denied: Tool call not allowed due to policy enforcement \\[.+\\]$"},
            {"const": "policy_session_required"},
            {"const": "ConflictException: the policy session was invalidated by a policy change; start a new session"}
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "decision_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
            "policy_id": {"type": ["string", "null"]},
            "stage": {"enum": ["a", "bt", "final"]},
            "reason_code": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "required": ["jsonrpc", "id", "error"],
  "additionalProperties": false
}
